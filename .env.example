APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Configuración de base de datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sivarsocial
DB_USERNAME=root
DB_PASSWORD=

# Configuración de sesiones mejorada
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Configuración de la aplicación
POSTS_PER_PAGE=24

# GIF API Configuration
GIPHY_API_KEY=tu_api_key

# Configuración de correo (avisos de LaU, p. ej. comercio aprobado)
# Opción A · Gmail: contraseña de aplicación de 16 caracteres de lauapp.es@gmail.com
#   (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
# Opción B · Resend (recomendada en producción): verifica el dominio lauapp.es en Resend y usa
#   MAIL_HOST=smtp.resend.com, MAIL_PORT=465, MAIL_SCHEME=smtps, MAIL_USERNAME=resend,
#   MAIL_PASSWORD=<API key re_...>, MAIL_FROM_ADDRESS=no-reply@lauapp.es (Resend no envía desde @gmail.com).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lauapp.es@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="lauapp.es@gmail.com"
MAIL_FROM_NAME="LaU"
# A dónde responden los comercios
MAIL_REPLY_TO_ADDRESS="lauapp.es@gmail.com"

#PUSHER
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER="us2"

# Firebase Configuration (Push Notifications)
FIREBASE_PROJECT_ID=io.ionic.lauapp

VITE_APP_NAME="${APP_NAME}"

# MAKE automation
MAKE_WEBHOOK_URL=

# PayPal (app Platform de LaU Marketplace). Nunca subas valores reales a Git.
# PAYPAL_MODE: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLATFORM_ACCOUNT_ID=
PAYPAL_BN_CODE=

# URL pública de la app: a dónde vuelve un comercio al conectar PayPal
FRONTEND_URL=https://lauapp.es

# TypeSafe AI (Jev): compra inteligente. La clave solo vive en el servidor.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# YouTube Data API v3 (opcional): videos de reseñas en la búsqueda inteligente.
# Google Cloud Console > APIs y servicios > habilitar "YouTube Data API v3" > Credenciales > Clave de API.
YOUTUBE_API_KEY=

# Agente de compras (chat): modelo abierto con API compatible con OpenAI.
# Local con Ollama: AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1 y AGENT_LLM_MODEL=qwen3.5:9b (sin API key).
# Producción (servidor sin GPU): el mismo tipo de modelo abierto en un proveedor gratuito, por ejemplo
# Groq: AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1, AGENT_LLM_MODEL=openai/gpt-oss-120b y su API key.
# Vacío = chat deshabilitado (la búsqueda inteligente sigue funcionando).
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT=120
# none | low | medium | high (cuánto "piensa" el modelo antes de responder)
AGENT_LLM_REASONING=low

# Inicio de sesión con Google (web): el client secret solo vive aquí, nunca en el frontend.
GOOGLE_WEB_CLIENT_SECRET=
# Redirecciones extra permitidas además de FRONTEND_URL/auth/callback (separadas por coma)
GOOGLE_OAUTH_EXTRA_REDIRECTS=http://localhost:5173/auth/callback

# Superusuario del panel (solo para el seeder inicial; después: php artisan lau:admin-password <email>)
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
SUPERUSER_VERIFY_PASSWORD=